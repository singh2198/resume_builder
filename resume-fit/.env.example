# Copy to .env. Server-only keys; never put secrets in VITE_ variables.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
# Use the same secret when configuring /api/payments/webhook in Razorpay.
RAZORPAY_WEBHOOK_SECRET=replace_with_a_random_secret
# Required when hosting on a public domain (no trailing slash).
APP_ORIGIN=http://127.0.0.1:5173
PORT=3001
# Optional: persistent storage directory for history, payments and purchased files.
# DATA_DIR=/absolute/path/to/persistent-data

# Optional AI wording improvements (server-only; never use a VITE_ prefix).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Hosting: use production only on the hosted service, with a stable secret.
# NODE_ENV=production
# HOST=0.0.0.0
# TRUST_PROXY_HOPS=1
# SESSION_SECRET=generate_a_random_secret_of_at_least_32_characters
# Global provider-attempt cap per UTC day (0 disables AI).
MAX_AI_REQUESTS_PER_DAY=100
