{
  "name": "resume-fit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test server/*.test.js",
    "setup:pdf": "node server/pdf/setup.js",
    "format": "prettier --write client server vite.config.js package.json",
    "format:check": "prettier --check client server vite.config.js package.json"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "docx": "^9.2.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "mammoth": "^1.9.0",
    "multer": "^2.0.2",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "3.9.10",
    "vite": "^6.1.0"
  }
}
